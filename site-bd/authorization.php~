<?php
// login.php
include 'config.php';
include 'classes/Database.php';
include 'classes/Users.php';
include 'classes/Auth.php';

$database = new Database();
$db = $database->connect();
$userClass = new User($db);
$auth = new Auth();

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $login = $_POST['login'];
    $password = $_POST['password'];

    if ($user = $userClass->login($login, $password)) {
        $auth->login($user);
        header("Location: login.php"); // Перенаправление на страницу после успешного входа
        exit();
    } else {
        echo "Неверный логин или пароль";
    }
}
