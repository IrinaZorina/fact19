<?php
include 'ins/header.php';
include 'config.php';
include 'classes/Database.php';
include 'classes/Users.php';
include 'classes/Auth.php';

$database = new Database();
$db = $database->connect();
$userClass = new User($db);
$auth = new Auth();

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $login = $_POST['login'];
    $password = $_POST['password'];
    $error = '';

    if ($user = $userClass->login($login, $password)) {
        $auth->login($user);
        header("Location: user.php");
        exit();
    } else {
        $error = "Неверный логин или пароль";
    }
}
?>

<form action="" method="post" class="authorization">
    <h2>Авторизация</h2>
    <label for="login">Логин</label>
    <input type="text" name="login" id="login" required>
    <label for="password">Пароль</label>
    <input type="password" name="password" id="password" required>
    <div class="box">
        <button type="submit" class="submit">Вход</button>
        <a href="registration.php"><button type="button" class="submit">Регистрация</button></a>
    </div>
</form>
<?php if (!empty($error)): ?>
    <p class="error"><?php echo $error; ?></p>
<?php endif; ?>

<?php include 'ins/footer.php'; ?>
