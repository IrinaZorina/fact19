body{
    margin: 0 ;
    background-color: #2c2b2b;
    background-size: cover;
    font-family: Tahoma;
    font-size: 18px;
}

header{
    width: 100%;
    height: 100px;
}

menu{
    padding: 0 40px 0 40px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

nav{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

nav a{
    font-weight: 600;
}

.linkHeader{
    text-decoration: none;
    color: #b2b1b1;
    padding-right: 20px;
}

h1{
    padding: 0;
    margin: 0;
}

.myContent{
    margin: 0 120px 0 120px;
    display: grid;
    grid-template-columns: 1fr 2fr 2fr;
    grid-template-rows: 1fr 2fr;
    gap: 40px;
}

.myFace{
    width: 350px;
    grid-column: 1/2;
    grid-row: 1/3;
}

.text2{
    color: #b2b1b1;
    grid-column: 3/4;
    grid-row: 2/3;
}

.text1{
    color: #b2b1b1;
    grid-column: 2/3;
    grid-row: 2/3;
}

.myName{
    color: #EFE9E1;
    grid-column: 2/4;
    grid-row: 1/2;
    text-align: center;
}

.sightsСity{
    margin: 0 120px 0 120px;

    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.sightsСity img{
    width: 250px;
    height: 200px;
    background-size: cover;
}

.itemSightsСity{
    width: 250px;
    height: 280px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0px 0 30px 0;
    background-color: #EFE9E1;
    color: #322d29;
}

.sightsRepublic{
    margin: 0 120px 0 120px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.sightsRepublic img{
    width: 500px;
    height: 400px;
    object-fit: contain;
    object-fit: cover;
}

h2{
    padding: 5% 0 3% 0;
    text-align: center;
    color: #EFE9E1;
}

.itemSightsRepublic{
    width: 500px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0px 0 30px 0;
    background-color: #EFE9E1;
    color: #322d29;
}

@media (max-width: 399px) {
    .myContent{
        margin: 0 20px 0 20px;
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: 40px 1fr 110px 150px;
        gap: 20px;
        padding: 0;
    }

    .myFace{
        width: 300px;
        grid-column: 1/2;
        grid-row: 2/3;
    }

    .myFace img{
        width: 200px;
    }

    .myName{
        font-size: 16px;
        grid-column: 1/2;
        grid-row: 1/2;
    }

    .text1{
        width: 300px;
        grid-column: 1/2;
        grid-row: 3/4;
    }

    .text2{
        width: 300px;
        grid-column: 1/2;
        grid-row: 4/5;
    }

    .sightsСity{
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .sightsRepublic{
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .itemSightsRepublic{
        width: 300px;
    }

    .sightsRepublic img{
        width: 300px;
        height: 200px;
    }
}

@media (min-width: 399px) and (max-width: 699px) {
    .myContent{
        margin: 0 40px 0 40px;
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: 40px 1fr 110px 150px;
        justify-items: center;
        gap: 20px;
        padding: 0;
    }

    .myFace{
        grid-column: 1/2;
        grid-row: 2/3;
    }

    .myFace img{
        width: 200px;
    }

    .myName{
        font-size: 22px;
        grid-column: 1/2;
        grid-row: 1/2;
    }

    .text1{
        padding: 0 20px 0 20px;
        width: 300px;
        grid-column: 1/2;
        grid-row: 3/4;
    }

    .text2{
        padding: 0 20px 0 20px;
        width: 300px;
        grid-column: 1/2;
        grid-row: 4/5;
    }
    .sightsСity{
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .sightsCity img{
        width: 450px;
        height: 350px;
    }

    .itemSightsCity{
        width: 450px;
    }

    .sightsRepublic{
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .itemSightsRepublic{
        width: 450px;
    }

    .sightsRepublic img{
        width: 450px;
        height: 350px;
    }

}

@media (min-width: 700px) and (max-width: 1400px) {
    .sightsСity{
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        flex-wrap: wrap;
        order: 2;
    }

    .myFace{
        width: 200px;
        grid-column: 1/2;
        grid-row: 1/5;
    }

    .myName{
        font-size: 25px;
    }

    .myContent{
        margin: 0 80px 0 80px;
    }

    .sightsRepublic{
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        order: 3;
    }

    .itemSightsRepublic{
        min-width: 300px;
        max-width: 350px;
    }

    .sightsRepublic img{
        min-width: 300px;
        max-width: 350px;
        min-height: 200px;
        max-height: 250px;
    }
}

/*Для Ячейки */
.container{
    background-color: #ffd53c;
    border: 1px solid black;
    padding: 2px;
    width: 100px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
}

.itemAs{
    font-size: 30px;
    font-weight: 600;
    grid-column-start: 1;
    grid-row-start: 1;
    grid-row-end: 3;
    justify-items: start;
}

.itemM{
    font-family: Tahoma;
    font-size: 16px;
    font-weight: 500;
    grid-column-start: 1;
    grid-column-end: 3;
    grid-row-start: 3;
    grid-row-end: 4;
}

.item33{
    font-size: 15px;
    font-family: Tahoma;
    font-weight: 600;
    text-align: right;
}